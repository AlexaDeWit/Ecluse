packages: . vendor/lzma-managed

-- Hackage amazonka 2.0 excludes GHC 9.10 and containers 0.7. Pin the upstream
-- revision with flake.nix amazonkaRev. checks.amazonka-lockstep enforces equality.
source-repository-package
  type:     git
  location: https://github.com/brendanhay/amazonka.git
  tag:      b562aa3f24845e34b95748daae671860017426be
  subdir:   lib/amazonka
            lib/amazonka-core
            lib/services/amazonka-sso
            lib/services/amazonka-sts
            lib/services/amazonka-codeartifact
            lib/services/amazonka-sqs
            lib/services/amazonka-s3

-- The Nix shell supplies the immutable patch. Its digest changes Cabal's source cache key.
source-repository-package
  type:     git
  location: https://github.com/kazu-yamamoto/http2.git
  tag:      fe92e9c1b9cc4e774ddc45962cd71b340496bf9b
  post-checkout-command: ecluse-apply-http2-patch d2c56dc4cac6265ee657bfc55ed168fc2e0f50cedfc2a58db54efd08a57fe08d

-- Keep this index recent enough for the versions task freeze takes from Nix.
-- See docs/getting-started.md, Dependency locking, for task bump-index-state.
index-state: 2026-10-17T17:19:18Z

-- Bare cabal test does not enable tests during solving. Keep every command
-- on the same tests-inclusive plan to avoid Cabal-7043.
tests: True

-- Bare cabal bench does not enable benchmarks during solving. Keep its
-- component in the plan to avoid Cabal-7043.
benchmarks: True

-- warp 3.4.10 to 3.4.13.1 closes testWithApplication connections before writing.
-- The stub then reports NoResponseDataReceived. Remove the cap after a fix.
constraints: warp < 3.4.10

-- Match the Nix overlays until upstream widens. regression-simple caps base, aeson 2.3 fixes
-- HSEC-2026-0007, amazonka-core caps crypton, crypton-connection caps x509 below 1.10.
allow-newer:
  regression-simple:base,
  insert-ordered-containers:aeson,
  openapi3:aeson,
  amazonka-core:crypton,
  crypton-connection:crypton-x509-store,
  crypton-connection:crypton-x509-system

-- Keep warnings fatal only for this package. A local override can use -Wwarn
-- in cabal.project.local. Compiler flags are documented in docs/style.md.
package ecluse
  ghc-options: -Werror
  -- Cabal tests need the loopback HTTP constructor. The release Nix build
  -- ignores this file and keeps the dev-http-egress flag off.
  flags: +dev-http-egress

[
  {
    "id": "traffic_value",
    "group": "overview",
    "title": "HTTP traffic, including probes",
    "unit": "req/s",
    "role": "proxy",
    "section": "always",
    "type": "query_value",
    "queries": [
      {
        "metric": "http.server.request.count",
        "alias": "Requests",
        "aggregation": "sum",
        "modifier": "rate"
      }
    ],
    "time_aggregation": "avg"
  },
  {
    "id": "http_errors_value",
    "group": "overview",
    "title": "HTTP 5xx fraction",
    "unit": "%",
    "role": "proxy",
    "section": "always",
    "type": "query_value",
    "queries": [
      {
        "metric": "http.server.request.count",
        "alias": "5xx",
        "aggregation": "sum",
        "modifier": "count",
        "filters": [
          "@status@:5*"
        ]
      },
      {
        "metric": "http.server.request.count",
        "alias": "All responses",
        "aggregation": "sum",
        "modifier": "count"
      }
    ],
    "time_aggregation": "sum",
    "formulas": [
      {
        "formula": "100 * q0 / q1",
        "alias": "5xx / all responses"
      }
    ]
  },
  {
    "id": "latency_value",
    "group": "overview",
    "title": "Mean HTTP latency",
    "unit": "ms",
    "role": "proxy",
    "section": "always",
    "type": "query_value",
    "queries": [
      {
        "metric": "http.server.request.duration",
        "alias": "Total duration",
        "aggregation": "sum",
        "modifier": "count"
      },
      {
        "metric": "http.server.request.duration",
        "alias": "Observations",
        "aggregation": "count",
        "modifier": "count"
      }
    ],
    "time_aggregation": "sum",
    "formulas": [
      {
        "formula": "1000 * q0 / q1",
        "alias": "Mean latency"
      }
    ]
  },
  {
    "id": "memory_value",
    "group": "overview",
    "title": "Metadata memory charged, fleet total",
    "unit": "B",
    "role": "proxy",
    "section": "always",
    "type": "query_value",
    "queries": [
      {
        "metric": "ecluse.serve.admission.memory.charged_bytes",
        "alias": "Charged",
        "aggregation": "sum",
        "modifier": "gauge"
      }
    ],
    "time_aggregation": "last"
  },
  {
    "id": "traffic",
    "group": "serving",
    "title": "HTTP responses by status",
    "unit": "responses/s",
    "role": "proxy",
    "section": "always",
    "type": "timeseries",
    "queries": [
      {
        "metric": "http.server.request.count",
        "alias": "Responses",
        "aggregation": "sum",
        "modifier": "rate",
        "group_by": [
          "@status@"
        ]
      }
    ]
  },
  {
    "id": "http_latency",
    "group": "serving",
    "title": "HTTP latency, including probes",
    "unit": "ms",

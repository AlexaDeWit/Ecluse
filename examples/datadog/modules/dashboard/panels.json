  {
    "id": "cache_full",
    "group": "capacity",
    "title": "Full cache hit and collapsed fractions",
    "unit": "%",
    "role": "proxy",
    "section": "always",
    "type": "timeseries",
    "queries": [
      {
        "metric": "ecluse.metadata_cache.requests",
        "alias": "Hit",
        "aggregation": "sum",
        "modifier": "count",
        "filters": [
          "result:hit",
          "NOT store:directory"
        ]
      },
      {
        "metric": "ecluse.metadata_cache.requests",
        "alias": "All lookups",
        "aggregation": "sum",
        "modifier": "count",
        "filters": [
          "NOT store:directory"
        ]
      },
      {
        "metric": "ecluse.metadata_cache.requests",
        "alias": "Collapsed",
        "aggregation": "sum",
        "modifier": "count",
        "filters": [
          "result:collapsed",
          "NOT store:directory"
        ]
      }
    ],
    "formulas": [
      {
        "formula": "100 * q0 / q1",
        "alias": "Hit fraction"
      },
      {
        "formula": "100 * q2 / q1",
        "alias": "Collapsed fraction"
      }
    ]
  },
  {

environment = "production"
scope_tags = { ecluse_deployment = "platform-east" }
instance_tag = "pod_name"
services = {
  proxy = ["ecluse-proxy"]
  mirror = ["ecluse-mirror"]
  dredger = ["ecluse-dredger"]
  pilot = ["ecluse-pilot"]
}
sections = { advisories = true, pilot = true, mirror = true, dredger = true, logs = true }

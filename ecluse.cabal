-- Live performance-acceptance harness: the PURE evaluation core. The
-- version-controlled acceptance criteria, the per-package budget verdict, and the
-- run-summary rendering. An INTERNAL sublibrary, following the ecluse-manifest pattern,
-- so the gating unit suite can test the acceptance decision deterministically. The live
-- fetch and timing stay in the perf-acceptance executable. Links ecluse-core only, and
-- stays out of the shipped library closure.
library ecluse-acceptance
  import:          shared
  hs-source-dirs:  acceptance/src
  exposed-modules:
    Ecluse.Acceptance
    Ecluse.Acceptance.Evidence
  build-depends:
    , ecluse:ecluse-report-format
    , ecluse:ecluse-core
    , aeson          >=2.2 && <2.4
    , bytestring     ^>=0.12
    , containers     ^>=0.7
    , text           ^>=2.1
    , universe-base  ^>=1.1

-- The performance-acceptance harness, kept out of the shipped library closure. `captures`
-- holds each leg's allocation over the committed captures to the budgets in
-- acceptance/criteria.json, and gates CI. `live` reports the same legs over live registry
-- documents and never gates. The shipped RTS options fix the runtime the figures come from.
executable perf-acceptance
  import:         shared
  import:         shipped-rts
  main-is:        Main.hs
  hs-source-dirs: acceptance/app
  build-depends:
    , ecluse
    , ecluse:ecluse-acceptance
    , ecluse:ecluse-core
    , ecluse:ecluse-test-support
    , aeson            >=2.2 && <2.4
    , bytestring       ^>=0.12
    , containers       ^>=0.7
    , http-client      ^>=0.7
    , http-client-tls  >=0.3.6 && <0.5
    , temporary        ^>=1.3
    , text             ^>=2.1
    , time             ^>=1.12
    , universe-base    ^>=1.1

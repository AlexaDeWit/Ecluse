-- The OpenAPI spec assembly: the pure (ManifestSource -> OpenApi) builder and
-- the owned schemas. An INTERNAL sublibrary, following the ecluse-test-support
-- pattern. That keeps the heavy OpenAPI dependency tree (openapi3, autodocodec, lens,
-- optics, and the rest) OUT of the shipped `library ecluse` and `executable ecluse`
-- closure. Only the openapi-gen generator and the ecluse-unit test suite depend on it,
-- never the app library. It links ecluse-core, for the Route enumeration and the
-- served types, not the app library.
library ecluse-manifest
  import:          shared
  hs-source-dirs:  manifest
  exposed-modules: Ecluse.Manifest
  build-depends:
    , ecluse:ecluse-core
    , aeson                      >=2.2 && <2.4
    , aeson-pretty               ^>=0.8
    , autodocodec                ^>=0.5
    , autodocodec-openapi3       ^>=0.3
    , http-media                 ^>=0.8
    , http-types                 ^>=0.12
    , insert-ordered-containers  ^>=0.2
    , openapi3                   ^>=3.2
    , text                       ^>=2.1

-- The OpenAPI spec generator: a build-time component that assembles the
-- OpenAPI document (Ecluse.Manifest) from the fixed canonical source and writes
-- the published openapi.json. It depends on the ecluse-manifest sublibrary, NOT the
-- app library, so the OpenAPI dependency tree never reaches the running proxy. Run
-- with `cabal run openapi-gen`.
executable openapi-gen
  import:         shared
  main-is:        Main.hs
  hs-source-dirs: gen
  build-depends:
    , directory          ^>=1.3
    , ecluse:ecluse-manifest
    , filepath           ^>=1.5

-- The site page renderer: the PURE Markdown rendering behind the site-gen
-- executable. It turns an OpenAPI document into the static API reference. An INTERNAL
-- sublibrary, following the ecluse-manifest pattern, so the gating unit suite
-- exercises the rendering deterministically. It reads no file and holds no OpenAPI
-- assembly, so it links neither the app library nor ecluse-manifest, and it stays out
-- of the shipped library closure.
library ecluse-site
  import:          shared
  hs-source-dirs:  site/src
  exposed-modules:
    Ecluse.Site.Markdown
    Ecluse.Site.OpenApi
    Ecluse.Site.Search

  build-depends:
    , ecluse:ecluse-report-format
    , http-media                 ^>=0.8
    , insert-ordered-containers  ^>=0.2
    , openapi3                   ^>=3.2
    , text                       ^>=2.1

-- The site fragment generator: the thin file-writing shell over ecluse-site. The site
-- build runs it for the OpenAPI reference, and Zola embeds the fragment. It takes the
-- OpenAPI document from ecluse-manifest, the same value openapi-gen serialises, so the
-- page and the published JSON come from one source. Run with `cabal run site-gen`.
executable site-gen
  import:         shared
  main-is:        Main.hs
  hs-source-dirs: site/app
  build-depends:
    , directory  ^>=1.3
    , ecluse:ecluse-manifest
    , ecluse:ecluse-site

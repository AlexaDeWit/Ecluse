-- Work-per-request micro-benches, generator correctness tests, and complexity assertions.
-- tasty-bench reports allocations beside time, and allocations hold across machines.
benchmark ecluse-bench
  import:          shared
  type:            exitcode-stdio-1.0
  main-is:         Main.hs
  hs-source-dirs:  bench
  -- Use the shipped -O1 default. Loopback replay needs the threaded RTS.
  -- -T lets tasty-bench report allocations without a caller flag.
  ghc-options:     -threaded -rtsopts "-with-rtsopts=-T"
  other-modules:
    Ecluse.Bench.Corpus
    Ecluse.Bench.Fit
    Ecluse.Core.AdvisoryRulesBench
    Ecluse.Core.CacheBench
    Ecluse.Core.ColdReadBench
    Ecluse.Core.DigestBench
    Ecluse.Core.MirrorReadBench
    Ecluse.Core.MergeBench
    Ecluse.Core.MetadataGzipBench
    Ecluse.Core.PackedBench
    Ecluse.Core.Registry.SweepBench
    Ecluse.Core.RouteBench
    Ecluse.Core.RulesBench
    Ecluse.Core.SecurityBench
    Ecluse.Core.SelectiveBench
    Ecluse.Core.ServeBench
    Ecluse.Core.StreamBench
    Ecluse.Core.StreamBench.Sink
    Ecluse.Core.VersionBench
    Ecluse.Core.WireBench

  build-depends:
    , ecluse:ecluse-report-format
    , ecluse:ecluse-core
    , ecluse:ecluse-runtime
    , ecluse:ecluse-runtime-test-support
    , ecluse:ecluse-test-support
    , aeson            >=2.2 && <2.4
    , bytestring       ^>=0.12
    , containers       ^>=0.7
    , directory        ^>=1.3
    , filepath         ^>=1.4 || ^>=1.5
    , http-client      ^>=0.7
    , http-types       ^>=0.12
    , streaming-commons ^>=0.2.3
    , tasty            ^>=1.5
    , tasty-bench      ^>=0.4
    , tasty-bench-fit  ^>=0.1
    , tasty-hunit      ^>=0.10
    , temporary        ^>=1.3
    , text             ^>=2.1
    , time             ^>=1.12
    , unliftio         ^>=0.2.25
    , wai              ^>=3.2
    , warp             ^>=3.4
    , zlib             ^>=0.7

-- The load tool links the composed application without entering the shipped library closure.
-- It is both the harness and, under --serve-proxy, the proxy process each scenario measures.
executable bench-load
  import:          shared
  -- A second -with-rtsopts would replace the shipped options rather than extend them, so each
  -- scenario child and each proxy gets -T for the RTS statistics through GHCRTS at launch.
  import:          shipped-rts
  main-is:         Main.hs
  hs-source-dirs:  bench/load

  -- The measured proxy dials in-process plain-http stub registries, so it needs the
  -- flag-gated loopback egress former (Ecluse.Core.Security.Egress.DevHttp). A
  -- release-posture build has the flag off, the Nix docs and Haddock check included.
  -- It carries no such module by design, so this dev-only tool does not build there.
  if !flag(dev-http-egress)
    buildable: False
  other-modules:
    Ecluse.BenchLoad.Advisories
    Ecluse.BenchLoad.AdvisoryStore
    Ecluse.BenchLoad.Contract.Driver
    Ecluse.BenchLoad.Stress
    Ecluse.BenchLoad.Error
    Ecluse.BenchLoad.Fixture
    Ecluse.BenchLoad.Listing
    Ecluse.BenchLoad.Harness
    Ecluse.BenchLoad.Npm
    Ecluse.BenchLoad.Worker
    Ecluse.BenchLoad.PyPI.Worker
    Ecluse.BenchLoad.Cargo
    Ecluse.BenchLoad.RubyGems
    Ecluse.BenchLoad.RubyGems.Directory
    Ecluse.BenchLoad.RubyGems.Worker
    Ecluse.BenchLoad.RubyGems.WorkerFixture
    Ecluse.BenchLoad.Cargo.CopyState
    Ecluse.BenchLoad.Cargo.Worker
    Ecluse.BenchLoad.Cargo.WorkerFixture
    Ecluse.BenchLoad.ObjectStore
    Ecluse.BenchLoad.WorkerState
    Ecluse.BenchLoad.PyPI.WorkerFixture
    Ecluse.BenchLoad.Oha
    Ecluse.BenchLoad.Placement
    Ecluse.BenchLoad.ProxyProcess
    Ecluse.BenchLoad.ProxyServe
    Ecluse.BenchLoad.PyPI
    Ecluse.BenchLoad.ManagedMirror
    Ecluse.BenchLoad.Replay
    Ecluse.BenchLoad.Report
    Ecluse.BenchLoad.RtsProbe
    Ecluse.BenchLoad.Scenarios
    Ecluse.BenchLoad.SlowReader
    Ecluse.BenchLoad.PatternScenario
    Ecluse.BenchLoad.PrivateCopy

  build-depends:
    , temporary         ^>=1.3
    , zlib ^>=0.7
    , wai-extra ^>=3.1
    , amazonka ^>=2.0
    , ecluse
    , ecluse:ecluse-bench-load
    , ecluse:ecluse-core
    , ecluse:ecluse-runtime
    , ecluse:ecluse-test-support
    , aeson            >=2.2 && <2.4
    , bytestring       ^>=0.12
    , containers       ^>=0.7
    , directory        ^>=1.3
    , filepath         ^>=1.4 || ^>=1.5
    , http-client      ^>=0.7
    , http-client-tls  >=0.3.6 && <0.5
    , http-types       ^>=0.12
    , katip            ^>=0.8.8
    , network          ^>=3.2
    , process          ^>=1.6
    , sqlite-simple    ^>=0.4
    , streaming-commons ^>=0.2.3
    , text             ^>=2.1
    , time             ^>=1.12
    , typed-process    ^>=0.2.13
    , unix             ^>=2.8
    , unliftio         ^>=0.2.25
    , wai              ^>=3.2
    , warp             ^>=3.4


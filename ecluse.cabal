-- Runtime-tier unit tests: cover the Ecluse.Runtime.* capability modules that need no
-- application library (the cloud adapters, the telemetry SDK wiring, and logging).
-- Pure, fast, deterministic. Gating. MUST NOT list the `ecluse` app library in
-- build-depends. That absence enforces the partition, mirroring ecluse-core-unit, so a
-- shell spec placed here by accident fails to compile. Ecluse.Runtime.Server and
-- Ecluse.Runtime.Env exercise the shell's runServer and runWorker, so their specs stay
-- in ecluse-unit. Those two modules are the unscoped entries in the ecluse-runtime-unit
-- guard in scripts/coverage.sh.
test-suite ecluse-runtime-unit
  import:             shared
  -- hspec-discover generates a Main without an export list. The telemetry specs drive
  -- the OpenTelemetry batch span processor through the live SDK, and it aborts under
  -- the non-threaded RTS, so the suite needs -threaded.
  ghc-options:        -Wno-missing-export-lists -threaded
  type:               exitcode-stdio-1.0
  main-is:            Spec.hs
  hs-source-dirs:     runtime/test/unit

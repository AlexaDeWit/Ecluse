-- Compile the test- and dev-only plain-HTTP loopback egress constructor
-- (Ecluse.Core.Security.Egress.DevHttp). OFF by default, so the release library and
-- executable carry no way to construct a non-https registry target. The dev shell and
-- the test and CI builds turn it ON, so the loopback integration suites compile.
-- `cabal.project` enables it for `cabal` in the dev shell, and the flake's unit-core
-- and unit-app checks pass -fdev-http-egress. The Nix-built release `ecluse` leaves
-- it off, because callCabal2nix ignores cabal.project and takes this default.
flag dev-http-egress
  description: Expose the test-only plain-HTTP loopback egress constructor.
  default:     False
  manual:      True

-- Shared settings for every component. relude replaces the default prelude via
-- cabal mixins (see docs/style.md).
common shared
  -- Warning set: -Wall plus extra warnings that reinforce the conventions in
  -- docs/style.md. cabal.project promotes a warning to an error for our own package.
  -- Deliberately omitted: -Wunused-packages (the relude mixin defeats its attribution,
  -- see docs/style.md), -Wmissing-import-lists (open imports for internal
  -- modules), and -Wmissing-local-signatures (a where-helper may stay inferred).
  ghc-options:
    -Wall -Wcompat -Widentities -Wincomplete-record-selectors
    -Wincomplete-record-updates -Wincomplete-uni-patterns
    -Wmissing-deriving-strategies -Wmissing-export-lists -Wname-shadowing
    -Wpartial-fields -Wredundant-bang-patterns -Wredundant-constraints

  default-language:   GHC2021
  default-extensions:
    DerivingStrategies
    LambdaCase
    OverloadedStrings
    StrictData

  build-depends:
    , base        ^>=4.20
    , file-embed  ^>=0.0.16
    , relude      ^>=1.2

  mixins:
    base hiding (Prelude),
    relude (Relude as Prelude)

-- The shipped server's RTS options. The OpenTelemetry batch processor requires the threaded RTS.
-- -T feeds the memory sampler, and the eager memory return keeps the cgroup's view of the heap
-- current. The boot derives -A and -M from the pod. The load harness links them too, so the proxy
-- it measures boots with the posture a pod gets before its cgroup reshapes it. The acceptance
-- harness links them so its allocation budgets hold under the shipped runtime. Tuning and
-- overrides: https://ecluse-proxy.com/docs/operations/.
common shipped-rts
  ghc-options: -threaded -rtsopts "-with-rtsopts=-N -A64m -n4m -T --disable-delayed-os-memory-return"

-- The maintained json-stream fork retains its BSD-3-Clause licence and public parser contract.
-- Its provenance and supported interface live in json-stream/README.md.
library ecluse-json-stream
  hs-source-dirs:   json-stream/src
  exposed-modules:
    Data.JsonStream.Lexer
    Data.JsonStream.Parser

  other-modules:
    Data.JsonStream.CLexer
    Data.JsonStream.Lexer.Internal
    Data.JsonStream.Number
    Data.JsonStream.TokenParser
    Data.JsonStream.Unescape
  default-language: Haskell2010
  ghc-options:      -Wall -fwarn-incomplete-uni-patterns
  build-depends:
    , aeson                 >=2.2      && <2.4
    , base                  ^>=4.20
    , bytestring            ^>=0.12
    , containers            ^>=0.7
    , primitive             ^>=0.9
    , scientific            ^>=0.3
    , text                  ^>=2.1
    , vector                ^>=0.13


-- Core unit tests: cover every Ecluse.Core.* module. Pure, fast, deterministic. Gating.
-- MUST NOT list the `ecluse` app library in build-depends. That absence enforces the
-- partition: an app spec placed here by accident fails to compile.
test-suite ecluse-core-unit
  import:             shared
  -- hspec-discover generates a Main without an export list. The admission wait needs
  -- -threaded, because GHC.Conc.registerDelay aborts under the non-threaded RTS. The
  -- served process always runs threaded, so the suite matches it.
  ghc-options:        -Wno-missing-export-lists -threaded
  type:               exitcode-stdio-1.0
  main-is:            Spec.hs
  -- Extra roots supply declarations for coverage audits, not discovered executable examples.
  -- The bench root supplies the streaming bench's sink model, which a spec here checks.
  hs-source-dirs:     core/test/unit test/smoke test/residency bench
  other-modules:
    SpecHook
    Ecluse.Core.Registry.CargoSmokeSpec

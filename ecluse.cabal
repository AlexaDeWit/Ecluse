    , sqlite-simple         ^>=0.4
    , http-client           ^>=0.7
    , http-client-tls       >=0.3.6.2 && <0.5
    -- The TLS manager's connector, whose refused-host exceptions the fault classifier reads by
    -- type. It is already in the resolved build plan through http-client-tls.
    , crypton-connection    ^>=0.4
    , http-conduit          ^>=2.3
    , http-types            ^>=0.12
    , hashable              ^>=1.5
    , hs-opentelemetry-api  ^>=1.0

  -- The PEP 440 and RubyGems version grammars. Internal to ecluse-core: VersionKey is
  -- opaque, so callers reach them only through the agnostic Ecluse.Core.Version API.
  -- Egress.Internal holds the raw RegistryUrl constructor. It is an other-module, so
  -- only code inside ecluse-core reaches it, and the app library and executable see
  -- only the abstract type through Ecluse.Core.Security.Egress.
  other-modules:
    Ecluse.Core.Security.Egress.Internal
    Ecluse.Core.Version.Gem
    Ecluse.Core.Version.Pep440

  -- The semver grammar and the lexical atoms the grammars share, exposed so their specs
  -- can import them. VersionKey stays opaque, so neither lets a caller build a key.
  exposed-modules:
    Ecluse.Core.Version.Semver
    Ecluse.Core.Version.Cargo
    Ecluse.Core.Version.Token

  other-modules:
    Paths_ecluse

  autogen-modules: Paths_ecluse

  -- The test and dev-only plain-HTTP loopback constructor, exposed only when the flag
  -- is on. A release build leaves the flag off, so the shipped artifact carries no
  -- such constructor.
  if flag(dev-http-egress)
    exposed-modules: Ecluse.Core.Security.Egress.DevHttp


{"schema_version":"1.9.0","id":"GHSA-gpvr-g6gh-9mc2","published":"2018-10-23T17:22:54Z","modified":"2023-11-08T03:57:43.877257Z","aliases":["CVE-2014-6393"],"summary":"No Charset in Content-Type Header in express","details":"Vulnerable versions of express do not specify a charset field in the content-type header while displaying 400 level response messages. The lack of enforcing user's browser to set correct charset, could be leveraged by an attacker to perform a cross-site scripting attack, using non-standard encodings, like UTF-7.\n\n\n## Recommendation\n\nFor express 3.x, update express to version 3.11 or later.\nFor express 4.x, update express to version 4.5 or later. ","affected":[{"package":{"name":"express","ecosystem":"npm","purl":"pkg:npm/express"},"ranges":[{"type":"SEMVER","events":[{"introduced":"0"},{"fixed":"3.11.0"}]}],"database_specific":{"source":"https://github.com/github/advisory-database/blob/main/advisories/github-reviewed/2018/10/GHSA-gpvr-g6gh-9mc2/GHSA-gpvr-g6gh-9mc2.json"}},{"package":{"name":"express","ecosystem":"npm","purl":"pkg:npm/express"},"ranges":[{"type":"SEMVER","events":[{"introduced":"4.0.0"},{"fixed":"4.5.0"}]}],"database_specific":{"source":"https://github.com/github/advisory-database/blob/main/advisories/github-reviewed/2018/10/GHSA-gpvr-g6gh-9mc2/GHSA-gpvr-g6gh-9mc2.json"}}],"references":[{"type":"ADVISORY","url":"https://nvd.nist.gov/vuln/detail/CVE-2014-6393"},{"type":"WEB","url":"https://bugzilla.redhat.com/show_bug.cgi?id=1203190"},{"type":"ADVISORY","url":"https://github.com/advisories/GHSA-gpvr-g6gh-9mc2"},{"type":"WEB","url":"https://www.npmjs.com/advisories/8"}],"database_specific":{"cwe_ids":["CWE-79"],"github_reviewed":true,"github_reviewed_at":"2020-06-16T21:37:54Z","nvd_published_at":"2017-08-09T18:29:00Z","severity":"MODERATE"},"severity":[{"type":"CVSS_V3","score":"CVSS:3.0/AV:N/AC:L/PR:N/UI:R/S:C/C:L/I:L/A:N"}]}
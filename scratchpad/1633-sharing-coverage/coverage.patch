+-- | Report the reducer's current envelope and listing ownership before its existing step.
+observeProjectionField :: Writer st -> PyPIProjection -> PyPIField -> ST st ()
+observeProjectionField writer acc field = recordFileDisposition writer $ case field of
+    EnvelopeField key _ -> if KeyMap.member (Key.fromText key) (projectedEnvelope acc) then "envelope-duplicate-discarded" else "envelope-first-retained"
+    FilesShape _ -> if projectedFilesSeen acc then "files-array-duplicate" else "files-array-first"
+    VersionsShape _ -> if projectedVersionsSeen acc then "versions-array-duplicate" else "versions-array-first"
+    InvalidVersionField _ _ -> if projectedVersionsActive acc && isNothing (projectedBound acc) then "invalid-version-retained" else "invalid-version-discarded"

+                                then normal 0 siz' empty (empty << v)
+                                else normal 0 siz' (empty << tv) empty
@@ -168,2 +176,2 @@ decodeSophisticated decTokenHeader rbuf = do
-        normal n builder cookie
-            | n > headerLimit = throwIO TooLargeHeader
+        normal n siz builder cookie
+            | n > headerLimit = malformed TooLargeHeader
@@ -176 +184 @@ decodeSophisticated decTokenHeader rbuf = do
-                        when isPseudo $ throwIO IllegalHeaderName
+                        when isPseudo $ malformed IllegalHeaderName
@@ -178 +186 @@ decodeSophisticated decTokenHeader rbuf = do
-                        when (tokenKey == "") $ throwIO IllegalHeaderName
+                        when (tokenKey == "") $ malformed IllegalHeaderName
@@ -180 +188,3 @@ decodeSophisticated decTokenHeader rbuf = do
-                            throwIO IllegalHeaderName
+                            malformed IllegalHeaderName
+                        let siz' = siz + fieldSize tv
+                        when (tooLarge siz') $ malformed TooLargeHeader
@@ -183,2 +193,2 @@ decodeSophisticated decTokenHeader rbuf = do
-                            then normal (n + 1) builder (cookie << v)
-                            else normal (n + 1) (builder << tv) cookie
+                            then normal (n + 1) siz' builder (cookie << v)
+                            else normal (n + 1) siz' (builder << tv) cookie
@@ -195,0 +206,10 @@ decodeSophisticated decTokenHeader rbuf = do
+    -- Decode the remaining fields to keep the dynamic table current.
+    malformed :: DecodeError -> IO a
+    malformed err = skipRest >> throwIO err
+    skipRest = do
+        leftover <- remainingSize rbuf
+        when (leftover >= 1) $ do
+            w <- read8 rbuf
+            _ <- decTokenHeader w rbuf
+            skipRest

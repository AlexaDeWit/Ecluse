@@ -155 +161,2 @@ decodeSophisticated decTokenHeader rbuf = do
-                            when (isMaxTokenIx tokenIx) $ throwIO IllegalHeaderName
+                            when (isMaxTokenIx tokenIx) $ malformed IllegalHeaderName
+                            when (tooLarge siz') $ malformed TooLargeHeader
@@ -157 +164 @@ decodeSophisticated decTokenHeader rbuf = do
-                            pseudo
+                            pseudo siz'
@@ -160 +167 @@ decodeSophisticated decTokenHeader rbuf = do
-                            when (tokenKey == "") $ throwIO IllegalHeaderName
+                            when (tokenKey == "") $ malformed IllegalHeaderName
@@ -162 +169,2 @@ decodeSophisticated decTokenHeader rbuf = do
-                                throwIO IllegalHeaderName
+                                malformed IllegalHeaderName
+                            when (tooLarge siz') $ malformed TooLargeHeader
@@ -165,2 +173,2 @@ decodeSophisticated decTokenHeader rbuf = do

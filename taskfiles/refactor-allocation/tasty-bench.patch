+-- Diagnostic counter reads bracket the action. Recording follows the native final global read.
+measureRecorded :: Diagnostic.Recorder -> TimeMode -> Word64 -> Benchmarkable -> IO Measurement
+measureRecorded recorder timeMode n (Benchmarkable act) = do
+  let getTimePicoSecs' = getTimePicoSecs timeMode
+  performGC
+  startTime <- getTimePicoSecs'
+  (startAllocs, startCopied, startMaxMemInUse) <- getAllocsAndCopied
+  threadStart <- getAllocationCounter
+  act n
+  threadEnd <- getAllocationCounter
+  endTime <- getTimePicoSecs'
+  performMinorGC
+  (endAllocs, endCopied, endMaxMemInUse) <- getAllocsAndCopied
+  Diagnostic.recordBatch recorder n startTime startAllocs endTime endAllocs threadStart threadEnd
+  pure Measurement
+    { measTime = endTime - startTime
+    , measAllocs = endAllocs - startAllocs
+    , measCopied = endCopied - startCopied
+    , measMaxMem = max endMaxMemInUse startMaxMemInUse
+    }
+
@@ -1130 +1152,11 @@
-measureUntil _ timeMode _ (RelStDev targetRelStDev) b
+measureUntil = measureUntilWith measure
+
+measureUntilWith

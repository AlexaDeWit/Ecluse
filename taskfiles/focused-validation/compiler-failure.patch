+-- | Record directory lifetimes for the temporary remote acceptance run.
+withSystemTempDirectory :: String -> (FilePath -> IO a) -> IO a
+withSystemTempDirectory label action = Temp.withSystemTempDirectory label $ \directory -> do
+    IO.hPutStrLn IO.stderr ("FOCUSED_DIRECTORY " <> directory)
+    action directory

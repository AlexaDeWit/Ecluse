# Both lexers overflow a signed long in handle_number on a number of 19 digits or more, then
# discard the value. A suppression names a function or a file, never a line. See docs/testing.md,
# "The vendored JSON lexer".
signed-integer-overflow:handle_number
signed-integer-overflow:upstream_handle_number
